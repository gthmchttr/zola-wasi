From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gautham Chettiar <gauthamchettiar@email.com>
Date: Fri, 23 Oct 2026 08:32:32 +0100
Subject: [PATCH] Build the zola CLI for wasm32-wasip1

`zola build`, `check`, `init` and `completion` now compile for WASI and
behave as they do natively, so a site can be built by any WASI runtime
(wasmtime, Node's node:wasi, or an in-browser shim):

    wasmtime run --dir my-site::/site zola.wasm --root /site build

`serve` needs a network stack and a file watcher, so it and its
dependencies are native-only. `check` skips external links on wasm (there
is no HTTP client there) and warns when it does so.

Building the C dependencies (oniguruma, zstd, libwebp) needs a clang that
targets WASI, e.g. from wasi-sdk:

    CC_wasm32_wasip1=$WASI_SDK/bin/clang \
    AR_wasm32_wasip1=$WASI_SDK/bin/llvm-ar \
    CFLAGS_wasm32_wasip1=--sysroot=$WASI_SDK/share/wasi-sysroot \
    cargo build --release --target wasm32-wasip1

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.toml     | 25 ++++++++++++++-----------
 src/cli.rs     |  3 +++
 src/cmd/mod.rs |  2 ++
 src/main.rs    | 12 ++++++++++++
 4 files changed, 31 insertions(+), 11 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 4b39fb3..807301d 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -32,16 +32,6 @@ name = "zola"
 [dependencies]
 clap = { version = "4", features = ["derive"] }
 clap_complete = "4"
-# Below is for the serve cmd
-axum = { version = "0.8", default-features = false, features = ["http1", "tokio", "ws"] }
-tokio = { version = "1.0.1", default-features = false, features = ["rt", "fs", "time", "net", "sync"] }
-notify-debouncer-full = "0.7"
-ctrlc = "3"
-open = "5"
-# For mimetype detection in serve mode
-mime_guess = "2.0"
-# For essence_str() function, see https://github.com/getzola/zola/issues/1845
-mime = "0.3.16"
 env_logger = { version ="0.11", default-features = false }
 
 site = { workspace = true }
@@ -52,7 +42,6 @@ utils = { workspace = true }
 link_checker = { workspace = true }
 search = { workspace = true }
 templates = { workspace = true }
-reqwest = { workspace = true }
 
 # Direct workspace deps used by the binary
 ahash = { workspace = true }
@@ -67,6 +56,20 @@ serde_json = { workspace = true }
 time = { workspace = true, features = ["formatting", "macros", "local-offset", "parsing"] }
 url = { workspace = true }
 
+# The serve command needs a network stack and a file watcher, which wasm targets don't have
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+axum = { version = "0.8", default-features = false, features = ["http1", "tokio", "ws"] }
+tokio = { version = "1.0.1", default-features = false, features = ["rt", "fs", "time", "net", "sync"] }
+notify-debouncer-full = "0.7"
+ctrlc = "3"
+open = "5"
+# For mimetype detection in serve mode
+mime_guess = "2.0"
+# For essence_str() function, see https://github.com/getzola/zola/issues/1845
+mime = "0.3.16"
+# For feature forwarding
+reqwest = { workspace = true }
+
 [dev-dependencies]
 same-file = "1"
 
diff --git a/src/cli.rs b/src/cli.rs
index 530e635..fdd6b46 100644
--- a/src/cli.rs
+++ b/src/cli.rs
@@ -1,3 +1,4 @@
+#[cfg(not(target_family = "wasm"))]
 use std::net::IpAddr;
 use std::path::PathBuf;
 
@@ -61,6 +62,8 @@ pub enum Command {
     },
 
     /// Serve the site. Rebuild and reload on change automatically
+    // Needs a network stack and a file watcher, neither of which exist on wasm targets
+    #[cfg(not(target_family = "wasm"))]
     Serve {
         /// Interface to bind on
         #[clap(short = 'i', long, default_value = "127.0.0.1")]
diff --git a/src/cmd/mod.rs b/src/cmd/mod.rs
index 004b864..8242dce 100644
--- a/src/cmd/mod.rs
+++ b/src/cmd/mod.rs
@@ -1,9 +1,11 @@
 mod build;
 mod check;
 mod init;
+#[cfg(not(target_family = "wasm"))]
 mod serve;
 
 pub use self::build::build;
 pub use self::check::check;
 pub use self::init::create_new_project;
+#[cfg(not(target_family = "wasm"))]
 pub use self::serve::serve;
diff --git a/src/main.rs b/src/main.rs
index 6fdc390..4e3e2b4 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -5,13 +5,16 @@ use std::time::Instant;
 use cli::{Cli, Command};
 use env_logger::Env;
 use errors::anyhow;
+#[cfg(not(target_family = "wasm"))]
 use utils::net::{get_available_port, port_is_available};
 
 use clap::{CommandFactory, Parser};
+#[cfg(not(target_family = "wasm"))]
 use time::UtcOffset;
 
 mod cli;
 mod cmd;
+#[cfg(not(target_family = "wasm"))]
 mod fs_utils;
 mod messages;
 mod prompt;
@@ -141,6 +144,7 @@ fn main() {
                 }
             }
         }
+        #[cfg(not(target_family = "wasm"))]
         Command::Serve {
             interface,
             mut port,
@@ -191,6 +195,14 @@ fn main() {
             }
         }
         Command::Check { drafts, skip_external_links } => {
+            // There is no HTTP client on wasm targets
+            #[cfg(target_family = "wasm")]
+            let skip_external_links = {
+                if !skip_external_links {
+                    log::warn!("External links can't be checked on WebAssembly, skipping them");
+                }
+                true
+            };
             log::info!("Checking site...");
             let start = Instant::now();
             let (root_dir, config_file) = get_config_file_path(&cli_dir, cli.config.as_deref());
